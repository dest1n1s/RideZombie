<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RideZombie</AssemblyName>
    <RootNamespace>RideZombie</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>embedded</DebugType>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/c/Program Files (x86)/Steam/steamapps/common/PEAK</GameDir>
    <ManagedDir>$(GameDir)/PEAK_Data/Managed</ManagedDir>
    <PluginsDir Condition="'$(PluginsDir)' == ''">/mnt/c/Users/Dest1n1s/AppData/Roaming/Thunderstore Mod Manager/DataFolder/PEAK/profiles/Default/BepInEx/plugins</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)/Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference Include="$(ManagedDir)/PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="$(ManagedDir)/PhotonRealtime.dll" Private="false" />
    <Reference Include="$(ManagedDir)/Photon3Unity3D.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(ManagedDir)/Zorro.Core.Runtime.dll" Private="false" />
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build" Condition="'$(PluginsDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)/Dest1n1-RideZombie" />
  </Target>

</Project>
